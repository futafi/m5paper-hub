  "build": {
    "arduino": { "ldscript": "esp32_out.ld", "partitions": "default_16MB.csv" },
    "core": "esp32",
    "extra_flags": "-DBOARD_HAS_PSRAM -mfix-esp32-psram-cache-issue",
    "f_cpu": "240000000L",
    "f_flash": "40000000L",
    "flash_mode": "dio",
    "mcu": "esp32",
    "variant": "esp32"
  },
  "connectivity": ["wifi", "bluetooth"],
  "frameworks": ["arduino"],
  "name": "M5Stack M5Paper v1.1 (ESP32)",
